        <PackageReference Include="NuGet.Packaging" Version="6.12.5" />
        <PackageReference Include="NuGet.Protocol" Version="6.12.5" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Docker.Example.Tests.Integration" />
    </ItemGroup>

